---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import JuliaCard from '../components/JuliaCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import {
  profile,
  metrics,
  impact,
  gallery,
  experience,
  skills,
  stack,
  education,
  languages,
  interests,
} from '../data/cv';

const nav = [
  { href: '#impacto', label: 'Impacto' },
  { href: '#experiencia', label: 'Experiencia' },
  { href: '#stack', label: 'Stack' },
  { href: '#contacto', label: 'Contacto' },
];

const bullet =
  'relative pl-6 before:absolute before:top-[0.7em] before:left-0 before:size-2 before:rounded-full before:bg-accent';
---

<Base>
  <header class="fixed inset-x-0 top-0 z-50 border-b border-line/60 bg-ink/75 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6" aria-label="Principal">
      <a href="#" class="group font-display text-xl font-extrabold tracking-tight" aria-label="Inicio">
        SHAO<span class="inline-block text-accent transition-transform group-hover:-translate-y-1">.</span>
      </a>
      <ul class="hidden gap-8 font-medium text-muted md:flex">
        {nav.map((item) => <li><a class="transition-colors hover:text-accent" href={item.href}>{item.label}</a></li>)}
      </ul>
      <a
        href="/cv"
        class="rounded-full border border-line px-4 py-1.5 font-medium transition-colors hover:border-accent hover:text-accent"
      >
        CV imprimible
      </a>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute -top-40 -left-40 size-[36rem] rounded-full bg-accent/15 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute top-40 right-0 size-[28rem] rounded-full bg-accent-2/10 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pt-28 pb-20 sm:px-6 md:grid-cols-[1.3fr_1fr] md:pt-36">
        <div>
          <p class="font-mono text-sm text-accent">{profile.location}</p>
          <h1 class="mt-4 font-display text-5xl leading-[1.02] font-extrabold tracking-tight sm:text-7xl">
            {profile.shortName}
          </h1>
          <p class="mt-5 font-display text-xl font-medium text-accent sm:text-2xl">{profile.headline}</p>
          <p class="mt-8 max-w-xl text-xl leading-relaxed text-fg/90">{profile.tagline}</p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href="#contacto"
              class="rounded-full bg-accent px-7 py-3 font-semibold text-ink shadow-[0_10px_30px_-10px] shadow-accent transition-transform hover:-translate-y-0.5"
            >
              Hablemos
            </a>
            <a
              href="#experiencia"
              class="rounded-full border border-line px-7 py-3 font-semibold transition-colors hover:border-accent hover:text-accent"
            >
              Ver trayectoria
            </a>
          </div>
        </div>

        <figure
          class="julia julia-vivid aspect-[3/4] w-full max-w-sm justify-self-center md:justify-self-end"
          tabindex="0"
          data-julia
        >
          <Image
            src={profile.heroPhoto}
            alt={profile.heroPhotoAlt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 768px) 384px, 90vw"
            loading="eager"
          />
          <figcaption>
            {profile.heroPhotoCredit.map((line) => <p class="julia-reveal">{line}</p>)}
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Métricas -->
    <section aria-label="Resultados clave" class="border-y border-line bg-ink-2">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-px bg-line lg:grid-cols-4">
        {
          metrics.map((m) => (
            <div class="group flex flex-col-reverse bg-ink-2 px-6 py-8 transition-colors hover:bg-ink-3">
              <dt class="mt-2 text-muted">{m.label}</dt>
              <dd class="font-display text-5xl font-extrabold tracking-tight transition-colors group-hover:text-accent">
                {m.value}
                {m.unit && <span class="ml-1 text-xl font-semibold text-muted">{m.unit}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Impacto -->
    <section id="impacto" class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <SectionHeading index="01" title="Impacto" />
      <p class="-mt-4 mb-12 max-w-3xl text-lg text-muted">{profile.summary}</p>
      <div class="grid gap-6 lg:grid-cols-3">
        {impact.map((card) => <JuliaCard card={card} />)}
      </div>
    </section>

    <!-- Experiencia -->
    <section id="experiencia" class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <SectionHeading index="02" title="Experiencia" />
      <ol class="space-y-6">
        {
          experience.map((job) => (
            <li class="group relative rounded-3xl border border-line bg-ink-2 p-6 transition-colors hover:border-accent/50 sm:p-8">
              <span
                class="absolute top-8 bottom-8 left-0 w-1 origin-top scale-y-0 rounded-full bg-accent transition-transform duration-500 group-hover:scale-y-100"
                aria-hidden="true"
              />
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-display text-2xl font-bold sm:text-3xl">{job.company}</h3>
                <span class="font-mono text-sm text-muted">{job.period}</span>
              </div>
              {job.description && <p class="mt-1 text-muted">{job.description}</p>}

              <div class="mt-6 space-y-8">
                {job.roles.map((role) => (
                  <div>
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                      <h4 class="text-lg font-bold text-accent">{role.title}</h4>
                      {job.roles.length > 1 && <span class="font-mono text-sm text-muted">{role.period}</span>}
                    </div>
                    {role.scope && <p class="mt-2 text-muted">{role.scope}</p>}
                    {role.highlights.length > 0 && (
                      <ul class="mt-4 space-y-3 text-fg/90">
                        {role.highlights.slice(0, 2).map((h) => (
                          <li class={bullet}>{h}</li>
                        ))}
                      </ul>
                    )}
                    {role.highlights.length > 2 && (
                      <details class="group/d mt-3">
                        <summary class="cursor-pointer list-none font-semibold text-accent hover:underline">
                          <span class="group-open/d:hidden">+ {role.highlights.length - 2} logros más</span>
                          <span class="hidden group-open/d:inline">− mostrar menos</span>
                        </summary>
                        <ul class="mt-3 space-y-3 text-fg/90">
                          {role.highlights.slice(2).map((h) => (
                            <li class={bullet}>{h}</li>
                          ))}
                        </ul>
                      </details>
                    )}
                  </div>
                ))}
              </div>

              {job.stack && (
                <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tecnologías">
                  {job.stack.map((tech) => (
                    <li class="chip group-hover:border-accent/50 group-hover:text-fg">{tech}</li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Stack y habilidades -->
    <section id="stack" class="relative overflow-hidden py-24">
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,--theme(--color-accent/12%),transparent_60%)]"
        aria-hidden="true"
      >
      </div>
      <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
        <SectionHeading index="03" title="Stack y habilidades" />
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            stack.map((g) => (
              <div class="tone-card" style={`--tone: ${g.color}`} data-spotlight>
                <h3 class="relative font-display text-xl font-bold">{g.group}</h3>
                <ul class="relative mt-5 flex flex-wrap gap-2">
                  {g.items.map((item, i) => (
                    <li class="chip" style={`--i: ${i}`}>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <ul class="mt-12 flex flex-wrap gap-3">
          {
            skills.map((s, i) => (
              <li class="tone-pill" style={`--tone: ${stack[i % stack.length].color}`}>
                {s}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Formación, idiomas, intereses -->
    <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <SectionHeading index="04" title="Formación y más" />
      <div class="grid gap-10 md:grid-cols-3">
        <div>
          <h3 class="font-mono text-sm tracking-widest text-accent uppercase">Formación</h3>
          <ul class="mt-4 space-y-4">
            {
              education.map((e) => (
                <li>
                  <p class="font-semibold">{e.degree}</p>
                  <p class="text-muted">
                    {e.school} · {e.period}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="font-mono text-sm tracking-widest text-accent uppercase">Idiomas</h3>
          <ul class="mt-4 space-y-4">
            {
              languages.map((l) => (
                <li>
                  <p class="font-semibold">{l.name}</p>
                  <p class="text-muted">{l.level}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="font-mono text-sm tracking-widest text-accent uppercase">Fuera del código</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {interests.map((i) => <li class="chip hover:border-accent-2 hover:bg-accent-2 hover:text-ink">{i}</li>)}
          </ul>
        </div>
      </div>

      <div class="mt-14 grid grid-flow-dense auto-rows-[11rem] grid-cols-2 gap-4 sm:auto-rows-[13rem] md:grid-cols-4">
        {
          gallery.map((g) => (
            <figure
              class:list={['shot', g.tall && 'row-span-2', g.wide && 'col-span-2', g.soft && 'shot-soft']}
              style={g.splash && `--tone: ${g.splash.tone}`}
              tabindex="0"
              data-julia
            >
              <Image
                src={g.photo}
                alt={g.alt}
                widths={[400, 700, 1200]}
                sizes={g.wide ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'}
                loading="lazy"
              />
              {g.splash && (
                <Image
                  class="shot-splash"
                  src={g.splash.photo}
                  alt=""
                  widths={[400, 700, 1200]}
                  sizes={g.wide ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'}
                  loading="lazy"
                />
              )}
              <figcaption>{g.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="border-t border-line bg-ink-2">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
        <SectionHeading index="05" title="Contacto" />
        <div class="flex flex-wrap justify-center gap-4">
        <a
          href={`mailto:${profile.email}`}
          class="rounded-full bg-accent px-7 py-3 font-semibold text-ink transition-transform hover:-translate-y-0.5"
        >
          {profile.email}
        </a>
        <a
          href={profile.linkedin}
          class="rounded-full border border-line px-7 py-3 font-semibold transition-colors hover:border-accent hover:text-accent"
          rel="me noopener"
          target="_blank">LinkedIn</a
        >
        <a
          href={profile.github}
          class="rounded-full border border-line px-7 py-3 font-semibold transition-colors hover:border-accent hover:text-accent"
          rel="me noopener"
          target="_blank">GitHub</a
        >
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line px-4 py-8 text-center text-muted">
    © {new Date().getFullYear()} {profile.name} · Fotos propias · Hecho con Astro y Tailwind
  </footer>
</Base>

<script>
  // Brillo de color que sigue al cursor en las tarjetas de stack.
  document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--x', `${e.clientX - r.left}px`);
      card.style.setProperty('--y', `${e.clientY - r.top}px`);
    });
  });
</script>
