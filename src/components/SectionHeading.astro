---
interface Props {
  index: string;
  title: string;
  id?: string;
}

const { index, title, id } = Astro.props;
---

<div class="mb-10 flex items-baseline gap-4">
  <span class="font-mono text-sm text-accent">{index}</span>
  <h2 id={id} class="font-display text-3xl font-medium tracking-tight sm:text-4xl">{title}</h2>
  <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
</div>
