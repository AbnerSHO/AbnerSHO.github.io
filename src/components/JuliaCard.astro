---
import { Image } from 'astro:assets';
import type { ImpactCard } from '../data/cv';

interface Props {
  card: ImpactCard;
}

const { card } = Astro.props;
---

<figure
  class:list={['julia min-h-[20rem] sm:min-h-[22rem]', card.wide && 'lg:col-span-2']}
  tabindex="0"
  data-julia
>
  <Image
    src={card.photo}
    alt={card.photoAlt}
    widths={[640, 1000, 1600]}
    sizes={card.wide ? '(min-width: 1024px) 66vw, 100vw' : '(min-width: 1024px) 33vw, 100vw'}
    loading="lazy"
  />
  <figcaption>
    <div class="mb-auto flex items-start justify-between gap-4">
      <p class="rounded-full bg-ink/60 px-3 py-1 font-mono text-xs tracking-widest text-accent uppercase backdrop-blur">
        {card.kicker}
      </p>
      <p
        class:list={[
          'font-display font-extrabold tracking-tight whitespace-nowrap text-white drop-shadow-lg',
          card.wide ? 'text-4xl sm:text-5xl' : 'text-4xl',
        ]}
      >
        {card.metric}
      </p>
    </div>
    <h3 set:html={card.title} />
    <p class="max-w-md text-sm text-fg/85 sm:text-base">{card.description}</p>
    <div class="mt-2 flex flex-col gap-1.5">
      {card.reveals.map((text) => <p class="julia-reveal">{text}</p>)}
    </div>
  </figcaption>
</figure>

<script>
  // En dispositivos sin hover, revelar el contenido cuando la tarjeta entra en vista.
  if (window.matchMedia('(hover: none)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.toggleAttribute('data-active', entry.isIntersecting);
        }
      },
      { threshold: 0.6 },
    );
    document.querySelectorAll('[data-julia]').forEach((el) => observer.observe(el));
  }
</script>
