---
// Franja fija al pie de la pantalla (sticky) donde caminan mascotas de temporada.
// Se genera oculta y el script la muestra solo si la fecha local cae en alguna
// temporada (o con ?temporada=<id>), y si quien visita no la ocultó este año.
import CatSprite from './CatSprite.astro';
import { seasons } from '../data/seasons';

const theme = {
  halloween: { emoji: '🎃', bg: 'bg-[#1b1436]/60', ground: 'bg-[#2a1a4f]/80' },
  navidad: { emoji: '🎄', bg: 'bg-[#0d2240]/60', ground: 'bg-white/80' },
};

// Copos de nieve: posición, duración y retraso fijos para que el HTML sea estable.
const snow = Array.from({ length: 18 }, (_, i) => ({
  left: (i * 37) % 100,
  duration: 5 + ((i * 7) % 5),
  delay: -((i * 13) % 9),
  size: 0.6 + ((i * 3) % 4) * 0.15,
}));
---

{
  seasons.map((season) => (
    <section
      class:list={[
        'season-strip pointer-events-none sticky bottom-0 z-40 h-24 border-t border-white/10 backdrop-blur-[3px] sm:h-28',
        theme[season.id].bg,
      ]}
      aria-label={`Decoración de ${season.label}`}
      data-season={season.id}
      data-from={season.from}
      data-to={season.to}
      data-emoji={theme[season.id].emoji}
      hidden
    >
      {season.id === 'halloween' && (
        <div aria-hidden="true">
          <div class="absolute top-3 left-[12%] size-8 rounded-full bg-[#f7e7b4] shadow-[0_0_40px_10px] shadow-[#f7e7b4]/25" />
          <span class="absolute top-4 left-[30%] animate-pulse text-lg">🦇</span>
          <span class="absolute top-7 right-[22%] animate-pulse text-base [animation-delay:1s]">🦇</span>
          <span class="absolute bottom-2 left-[6%] text-2xl">🎃</span>
          <span class="absolute right-[8%] bottom-2 text-2xl">🎃</span>
        </div>
      )}
      {season.id === 'navidad' && (
        <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
          {snow.map((f) => (
            <span
              class="snowflake"
              style={`left: ${f.left}%; font-size: ${f.size}rem; animation-duration: ${f.duration}s; animation-delay: ${f.delay}s`}
            >
              ❄
            </span>
          ))}
          <span class="absolute top-3 left-[12%] animate-pulse text-xl">⭐</span>
          <span class="absolute bottom-2 left-[5%] text-3xl">🎄</span>
          <span class="absolute right-[8%] bottom-2 text-2xl">🎁</span>
          <span class="absolute right-[12%] bottom-2 text-xl">🎁</span>
        </div>
      )}
      <div class:list={['absolute inset-x-0 bottom-0 h-2', theme[season.id].ground]} aria-hidden="true" />

      {season.pets.map((pet, i) => (
        <div
          class="pet pointer-events-auto"
          style={`--d: ${pet.duration}s; --delay: ${pet.delay}s; --rest: ${18 + i * 30}%`}
          tabindex="0"
          role="img"
          aria-label={pet.says}
        >
          <span class="bubble">{pet.says}</span>
          <CatSprite sprite={pet.sprite} />
        </div>
      ))}

      <button
        type="button"
        class="pointer-events-auto absolute top-2 right-2 grid size-8 place-items-center rounded-full border border-white/15 bg-ink/60 text-sm text-muted backdrop-blur transition-colors hover:text-fg sm:right-3 sm:flex sm:size-auto sm:px-3 sm:py-1"
        aria-label="Ocultar gatos"
        title="Ocultar gatos"
        data-season-hide
      >
        <!-- En móvil solo el ícono de ojo tachado; en pantallas grandes, el texto -->
        <svg class="size-4 sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10.7 5.1A9.8 9.8 0 0 1 12 5c6.5 0 10 7 10 7a17.6 17.6 0 0 1-2.2 3.1M6.6 6.6C3.7 8.5 2 12 2 12s3.5 7 10 7a9.7 9.7 0 0 0 5.4-1.6" />
          <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
          <path d="M2 2l20 20" />
        </svg>
        <span class="hidden sm:inline">Ocultar gatos</span>
      </button>
    </section>
  ))
}

<button
  type="button"
  class="mx-auto my-5 block text-sm text-muted underline-offset-4 hover:text-accent hover:underline"
  data-season-show
  hidden
>
  Ver los gatos de temporada
</button>

<style>
  .season-strip {
    /* Recorta a los lados (los gatos entran y salen) pero deja ver el globo arriba. */
    overflow-x: clip;
    overflow-y: visible;
  }
  .snowflake {
    position: absolute;
    top: -1rem;
    color: white;
    opacity: 0.8;
    animation: fall linear infinite;
  }
  .pet {
    position: absolute;
    bottom: 6px;
    left: 0;
    animation: walk var(--d) linear var(--delay) infinite;
    cursor: pointer;
  }
  .pet :global(svg) {
    display: block;
    overflow: visible;
    width: 84px;
    height: 63px;
    animation: bob 0.45s ease-in-out infinite alternate;
    filter: drop-shadow(0 4px 6px rgb(0 0 0 / 0.45));
  }
  .pet :global(.leg) {
    transform-box: fill-box;
    transform-origin: top;
    animation: step 0.45s ease-in-out infinite alternate;
  }
  .pet :global(.leg.leg-b) {
    animation-direction: alternate-reverse;
  }
  .pet :global(.tail) {
    transform-box: fill-box;
    transform-origin: 100% 100%;
    animation: wag 1.1s ease-in-out infinite alternate;
  }
  .bubble {
    position: absolute;
    bottom: 100%;
    left: 50%;
    translate: -50% 6px;
    white-space: nowrap;
    border-radius: 999px;
    background: white;
    color: #0b1118;
    padding: 0.25rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s,
      translate 0.2s;
  }
  .pet:is(:hover, :focus-visible) {
    z-index: 1;
  }
  .pet:is(:hover, :focus-visible),
  .pet:is(:hover, :focus-visible) :global(svg),
  .pet:is(:hover, :focus-visible) :global(.leg),
  .pet:is(:hover, :focus-visible) :global(.tail) {
    animation-play-state: paused;
  }
  .pet:is(:hover, :focus-visible) .bubble {
    opacity: 1;
    translate: -50% -4px;
  }

  @keyframes walk {
    from {
      transform: translateX(-150px);
    }
    to {
      transform: translateX(calc(100vw + 20px));
    }
  }
  @media (min-width: 640px) {
    .pet :global(svg) {
      width: 108px;
      height: 81px;
    }
  }

  @keyframes fall {
    to {
      transform: translate(12px, 8rem) rotate(180deg);
    }
  }
  @keyframes bob {
    to {
      transform: translateY(-3px);
    }
  }
  @keyframes step {
    from {
      transform: rotate(-18deg);
    }
    to {
      transform: rotate(18deg);
    }
  }
  @keyframes wag {
    from {
      transform: rotate(-10deg);
    }
    to {
      transform: rotate(14deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pet,
    .snowflake,
    .pet :global(svg),
    .pet :global(.leg),
    .pet :global(.tail) {
      animation: none;
    }
    .pet {
      left: var(--rest);
    }
  }
</style>

<script>
  const KEY = 'seasonal-pets-hidden';
  const showButton = document.querySelector<HTMLButtonElement>('[data-season-show]');

  const read = (): string | null => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };
  const write = (value: string | null) => {
    try {
      if (value === null) localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, value);
    } catch {
      // Sin almacenamiento disponible: solo afecta esta visita.
    }
  };

  const now = new Date();
  const today = `${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
  const forced = new URLSearchParams(location.search).get('temporada');
  const inRange = (from: string, to: string) =>
    from <= to ? today >= from && today <= to : today >= from || today <= to;

  const strip = [...document.querySelectorAll<HTMLElement>('[data-season]')].find((el) =>
    forced ? el.dataset.season === forced : inRange(el.dataset.from!, el.dataset.to!),
  );

  if (strip) {
    // Se recuerda por temporada y año: la próxima vez que llegue la temporada vuelven a salir.
    // En temporadas que cruzan el año (Navidad), enero cuenta como la del año anterior.
    const { from, to } = strip.dataset as { from: string; to: string };
    const year = from > to && today <= to ? now.getFullYear() - 1 : now.getFullYear();
    const id = `${strip.dataset.season}-${year}`;
    if (showButton) showButton.textContent = `${strip.dataset.emoji} Ver los gatos de temporada`;
    const render = () => {
      const hidden = read() === id;
      strip.hidden = hidden;
      if (showButton) showButton.hidden = !hidden;
    };
    strip.querySelector('[data-season-hide]')?.addEventListener('click', () => {
      write(id);
      render();
    });
    showButton?.addEventListener('click', () => {
      write(null);
      render();
    });
    render();
  }
</script>
